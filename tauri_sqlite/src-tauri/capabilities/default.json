{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    {
      "identifier": "fs:scope",
      "allow": [
        "$RESOURCE/**",
        "C:/Users/marc/Documents/repos/trivia/data/**"
      ]
    }
  ]
}