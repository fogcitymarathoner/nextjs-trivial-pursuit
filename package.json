{
  "name": "trivia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tst": "tsx -r tsconfig-paths/register scripts/tst.ts",
    "test": "jest --env=jsdom",
    "test:jest": "jest --env=jsdom",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "test:jest:ci": "jest --ci --coverage",
    "test:jest:integration": "cross-env RUN_INTEGRATION_TESTS=true jest",
    "test:jest:integration:coverage": "cross-env RUN_INTEGRATION_TESTS=true jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "cross-env COVERAGE=true playwright test",
    "test:e2e:coverage:ci": "cross-env COVERAGE=true playwright test --ci",
    "coverage:playwright:report": "npx monocart-reporter --config coverage/playwright",
    "test:e2e:coverage:threshold": "cross-env COVERAGE=true CHECK_COVERAGE=true playwright test",
    "test:e2e:coverage:report": "cross-env COVERAGE=true playwright test && yarn coverage:playwright",
    "coverage:playwright": "nyc report --reporter=lcov --reporter=html --reporter=text --reporter=text-summary --report-dir=coverage/playwright",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug --project=chromium",
    "test:e2e:watch": "playwright test --watch",
    "test:e2e:coverage:ui": "cross-env COVERAGE=true playwright test --ui",
    "test:e2e:coverage:headed": "cross-env COVERAGE=true playwright test --headed --project=chromium",
    "test:e2e:integration": "cross-env RUN_INTEGRATION_TESTS=true playwright test",
    "test:e2e:integration:coverage": "cross-env RUN_INTEGRATION_TESTS=true COVERAGE=true playwright test",
    "coverage:jest": "echo '✅ Jest coverage: coverage/jest/index.html'",
    "coverage:all": "yarn test:jest:coverage && yarn test:e2e:coverage",
    "coverage:open:jest": "open coverage/jest/index.html || xdg-open coverage/jest/index.html || start coverage/jest/index.html",
    "coverage:open:playwright": "open coverage/playwright/index.html || xdg-open coverage/playwright/index.html || start coverage/playwright/index.html",
    "test:all": "yarn test && yarn test:e2e",
    "test:all:coverage": "yarn test:jest:coverage && yarn test:e2e:coverage",
    "test:ci": "yarn test:jest:ci && yarn test:e2e:coverage:ci",
    "clean": "rimraf .next coverage .nyc_output playwright-report test-results .jest-cache"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.16.0",
    "firebase-admin": "12.7.0",
    "googleapis": "^172.0.0",
    "jest-axe": "^10.0.0",
    "jq": "^1.7.2",
    "next": "16.2.6",
    "openai": "^6.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-istanbul": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "critters": "^0.0.25",
    "cross-env": "^10.1.0",
    "cross-fetch": "^4.1.0",
    "domhandler": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "monocart-reporter": "^2.12.2",
    "nyc": "^18.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "dotenv": "^17.4.2",
    "openai": "^6.39.0",
    "firebase-admin": "12.7.0"
  }
}
